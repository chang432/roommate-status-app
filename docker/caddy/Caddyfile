# Caddy site config for one Roomie Status app cluster.
#
# Serves the static React/Vite bundle and proxies /api to the Flask container.
# Plain HTTP on :80 only: TLS and the public hostname are terminated one hop
# earlier by the shared edge proxy (docker/edge/), which is what lets the dev
# and prod clusters run side by side on one VPS without fighting over port 443
# or over a cert. Locally this is also what http://localhost hits, so there is
# one config for both.

:80 {
	# Compress responses; zstd preferred, gzip fallback. The edge forwards the
	# client's Accept-Encoding untouched, so compression happens here, once.
	encode zstd gzip

	# API calls go to the Flask container (service name from docker-compose).
	# The /api prefix is preserved because the Flask routes are mounted under it.
	handle /api/* {
		reverse_proxy flask:8000
	}

	# Everything else is the single-page app: serve the static bundle and fall
	# back to index.html so client-side (react-router) routes resolve instead of
	# 404ing on deep links / refreshes.
	handle {
		root * /srv

		# Cache Vite's fingerprinted assets aggressively; filenames are hashed.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
